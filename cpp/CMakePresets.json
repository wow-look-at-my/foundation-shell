{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Debug Build",
            "description": "Default build configuration for development",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": ["macOS"]
                }
            }
        },
        {
            "name": "release",
            "displayName": "Release Build",
            "description": "Optimized release build",
            "generator": "Ninja", 
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_TESTING": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "vscode",
            "displayName": "VS Code Development",
            "description": "Configuration optimized for VS Code development",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON", 
                "BUILD_TESTING": "ON",
                "CMAKE_C_COMPILER": "/opt/homebrew/bin/clang",
                "CMAKE_CXX_COMPILER": "/opt/homebrew/bin/clang++"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "displayName": "Build Default",
            "configurePreset": "default"
        },
        {
            "name": "release", 
            "displayName": "Build Release",
            "configurePreset": "release"
        },
        {
            "name": "vscode",
            "displayName": "Build VS Code",
            "configurePreset": "vscode"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "displayName": "Test Default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 30
            }
        },
        {
            "name": "vscode", 
            "displayName": "Test VS Code",
            "configurePreset": "vscode",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "timeout": 30
            }
        }
    ]
}